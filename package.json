{
  "name": "llm-guard-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Drop-in LLM security proxy: PII redaction with reversible placeholders, prompt-injection defense, outbound leak + canary scanning. Cloudflare Worker.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "tsx scripts/local-server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx evals/run.ts",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
